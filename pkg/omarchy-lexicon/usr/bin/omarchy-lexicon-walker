#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WORDLIST="${LEXICON_WORDLIST:-/usr/share/dict/words}"
SORT_MODE="${LEXICON_SORT_MODE:-alpha}"
LENGTH="${LEXICON_LENGTH:-}"
PATTERN="${LEXICON_PATTERN:-}"
RACK="${LEXICON_RACK:-}"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Python 3 is required for omarchy-lexicon." >&2
  exit 1
fi

ARGS=(--wordlist "$WORDLIST" --sort "$SORT_MODE")
if [ -n "$LENGTH" ]; then
  ARGS+=(--length "$LENGTH")
fi
if [ -n "$PATTERN" ]; then
  ARGS+=(--pattern "$PATTERN")
fi
if [ -n "$RACK" ]; then
  ARGS+=(--rack "$RACK")
fi

if ! command -v walker >/dev/null 2>&1; then
  echo "walker is not installed. Install walker or set up a compatible launcher." >&2
  exit 1
fi

FILTERED="$("$ROOT/bin/omarchy-lexicon" "${ARGS[@]}" 2>/dev/null || true)"
if [ -z "$FILTERED" ]; then
  echo "No words matched the current filters." >&2
  exit 1
fi

SELECTED="$(printf '%s\n' "$FILTERED" | walker --dmenu -p "lexicon" 2>/dev/null || true)"
if [ -z "$SELECTED" ]; then
  exit 0
fi

printf '%s' "$SELECTED" | wl-copy 2>/dev/null || true
printf '%s\n' "$SELECTED"

if command -v dict >/dev/null 2>&1; then
  echo "---" >&2
  dict "$SELECTED" 2>/dev/null || true
fi
